# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=suitesme
DB_USER=postgres
DB_PASSWORD=postgres

# HTTP
HTTP_ADDR=:8080

# JWT
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_MINUTES=10080
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ADMIN_TOKEN_SECRET=your_admin_token_secret

# Email (RuSender API — https://rusender.ru/developer/api/email/)
EMAIL_SEND_FROM=your_verified_sender@yourdomain.com
EMAIL_SEND_FROM_NAME=SuitesMe
RUSENDER_API_KEY=your_rusender_api_key
# Старые SMTP-переменные (не используются при RuSender):
# EMAIL_PASSWORD=...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
# Note: URLs are now stored as relative paths (/files/bucket/...) to avoid IP dependency
# MINIO_FILE_PATH_ENDPOINT is kept for backwards compatibility but not used for new uploads
MINIO_FILE_PATH_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
STYLE_PHOTO_BUCKET=style-photos
STYLE_PDF_BUCKET=style-pdfs
ML_ARTIFACTS_BUCKET=ml-artifacts

# External Services
AMOCRM_ACCESS_TOKEN=your_amocrm_access_token
PRODAMUS_TOKEN=your_prodamus_token
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
# Optional: metadata "source" value to filter webhooks when one endpoint serves multiple sites (default: ai_mne_idet)
# STRIPE_WEBHOOK_SOURCE=ai_mne_idet

# Logging
LOG_LEVEL=debug
